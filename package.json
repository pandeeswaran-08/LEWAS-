{
  "name": "western-ghats-lews-workspace",
  "version": "1.0.0",
  "description": "Western Ghats Multi-Agent Landslide Early Warning System - Fullstack Monorepo Workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "start:backend": "npm start --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "preview:frontend": "npm run preview --workspace=frontend",
    "install:all": "npm install",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "concurrently": "^10.0.5"
  },
  "keywords": [
    "landslide",
    "early-warning-system",
    "western-ghats",
    "agentic-ai",
    "groq",
    "sentinel-hub"
  ],
  "author": "Western Ghats EWS Team",
  "license": "ISC"
}
